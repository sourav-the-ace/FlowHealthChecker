<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Flow Health Checker Viewer</label>
    <description>Read-only access to Flow Health Checker — can view scan results but cannot run scans.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Apex Classes — view only controller -->
    <classAccesses>
        <apexClass>FlowHealthCheckerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Flow Scan — read only -->
    <objectPermissions>
        <object>Flow_Scan__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Flow Scan Result — read only -->
    <objectPermissions>
        <object>Flow_Scan_Result__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Flow Scan fields — read only -->
    
    <fieldPermissions>
        <field>Flow_Scan__c.Total_Flows_Scanned__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Flow_Scan__c.Total_Violations__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Flow_Scan__c.Status__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Flow_Scan__c.Error_Message__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- Flow Scan Result fields — read only -->
    
    <fieldPermissions>
        <field>Flow_Scan_Result__c.Element_Name__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Flow_Scan_Result__c.Description__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Flow_Scan_Result__c.Flow_Definition_Id__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- Tab access -->
    <tabSettings>
        <tab>Flow_Scan__c</tab>
        <visibility>Available</visibility>
    </tabSettings>
</PermissionSet>